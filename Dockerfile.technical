FROM freqtradeorg/freqtrade:2025.7

# Pin versions so a breaking hyperliquid-python-sdk release cannot silently
# change the error-message wording that the strategy scrapes for volume.
RUN pip3 install \
    "ta==0.11.0" \
    "tqdm==4.66.5" \
    "scipy==1.13.1" \
    "plotly==5.24.1" \
    "yfinance==0.2.50" \
    "statsmodels==0.14.4" \
    "hyperliquid-python-sdk==0.11.0"
